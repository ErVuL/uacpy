0.0                 ! title line, read and discarded (must start with a number)
75.0  75.0          ! center frequency fc (Hz) and Q; bandwidth = fc/Q
1.0                 ! time window width T (s); frequency spacing df = 1/T
500.0               ! source depth (m)
1.0                 ! deltaz - depth accuracy parameter (m)
100.0               ! deltar - range accuracy parameter (m)
4 1                 ! np - # pade coefficients, ns - # stability terms
1000.0              ! rs - stability range (m)
10                  ! output depth decimation (integer)
1500.0              ! c0_user - PE reference speed (m/s); must be positive
test.ssp
0                   ! flat earth transform: 0=no, 1=yes
0                   ! horizontal linear interpolation: 0=no, 1=yes
1                   ! ocean bottom: 0=no, 1=read the bathymetry file
test.bth
ranges.dat
300.0               ! sedlayer - sediment layer thickness (m)
4                   ! nzs - sediment depth control points (minimum 4)
0                   ! isedrd: 0=range-independent, 1=range-dependent from file
0.0 0.0 200.0 200.0 ! cs - sediment speed offset vs water (m/s), nzs values
1.2 1.2 1.2 1.2     ! rho - sediment density (g/cm^3), nzs values
0.5 0.5 5.0 5.0     ! attn - sediment attenuation (dB/wavelength), nzs values
